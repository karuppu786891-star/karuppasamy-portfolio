# â”€â”€â”€â”€â”€â”€â”€â”€â”€ Database (required for the admin dashboard to save) â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Any PostgreSQL URL: Neon, Supabase, Vercel Postgres, Railwayâ€¦
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# â”€â”€â”€â”€â”€â”€â”€â”€â”€ Admin login (required for /admin) â”€â”€â”€â”€â”€â”€â”€â”€â”€
# 1) Generate a secret:   openssl rand -base64 32
AUTH_SECRET=replace-with-output-from-npm-run-admin-secret
ADMIN_EMAIL=karuppasamyc804@gmail.com
# 2) Generate the hash:   npm run admin:password
#    Type it into the hidden prompt. Paste the ESCAPED hash into .env for Next.js.
ADMIN_PASSWORD_HASH=replace-with-output-from-npm-run-admin-password

# â”€â”€â”€â”€â”€â”€â”€â”€â”€ Image uploads (optional â€” you can still paste image URLs) â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Server-only Vercel Blob read/write token (never prefix with NEXT_PUBLIC_).
# Create/connect a public Blob store in Vercel, then copy its token here for local development.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# â”€â”€â”€â”€â”€â”€â”€â”€â”€ Contact form delivery (optional â€” form shows "not active" without it) â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Resend (https://resend.com): API key + a verified sender + where to receive messages
RESEND_API_KEY=your_value_here
CONTACT_FROM_EMAIL=your_value_here
CONTACT_TO_EMAIL=your_value_here
